# intent_phrasings.jsonl — regression corpus for parse_intent (LLM-OFF).
#
# CONVENTION: every parser bugfix should add a corpus row here, not just an
# instance test in test_intent_parser.py — the corpus is the systematic
# regression net; an instance test alone lets a fixed bug class silently
# regress unnoticed.
#
# One JSON object per line. Fields:
#   id       : unique kebab-case identifier
#   category : destination_city | destination_country | destination_region |
#              destination_directional | multi_city | origin | duration |
#              date_specific | date_month | date_inquiry | budget_explicit |
#              filler | greeting | vibe | unsupported | party_composition |
#              date_range
#   text     : the raw free-text utterance
#   context  : {"today": "YYYY-MM-DD"} for deterministic relative-date tests
#   expect   : {
#                outcome: resolve|clarify|decline|no_filler_in_decline
#                cities        : [exact ordered list]          (resolve)
#                cities_include: [must appear in cities]       (resolve)
#                cities_exclude: [must NOT appear in cities]   (resolve)
#                cities_any_of : [at least one must appear]    (resolve)
#                min_city_count: N                             (resolve)
#                checkin_year  : YYYY                         (resolve)
#                checkin_month : MM                           (resolve)
#                budget_min_cents: N                          (resolve)
#                adults        : N          (resolve)
#                nights        : N          (resolve)
#                slot          : date|budget|destination|...  (clarify)
#                filler_tokens : [...]  (no_filler_in_decline)
#              }
#   xfail       : true  (row expected to FAIL until named phase is done)
#   xfail_reason: string
#   notes    : free-text rationale

