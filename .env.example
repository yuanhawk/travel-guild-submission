# Travel Guild engine — example environment file. Copy to .env and fill in
# real values for the LLM-on path; the LLM-off demo (./demo.sh / demo.py)
# needs NONE of these.

# --- Qwen / DashScope (LLM-on edges: intent parse, area ranking, hotel ranking) ---
DASHSCOPE_API_KEY=sk-REPLACE_ME

# --- UCP merchant (Go service) ---
UCP_LISTEN_ADDR=127.0.0.1:8090
UCP_MERCHANT_BASE_URL=http://127.0.0.1:8090
# Demo convenience only -- unsigned requests default to browse-only L1;
# production deployments require RFC 9421-signed requests instead of this.
UCP_UNSIGNED_TIER=L2
# Path to a PEM signing key; if unset, an ephemeral P-256 key is generated at
# boot (fine for a demo, not for a stable production identity).
UCP_SIGNING_KEY_PATH=

# --- KMS-hardened signing (NOT ACTIVATED in this repo -- see ALICLOUD-PROOF.md) ---
# Documented production-hardening seam for the NHI signing key. Leave disabled;
# the on-disk/ephemeral key path above is what this repo actually runs on.
UCP_KMS_ENABLED=0
UCP_KMS_KEY_ID=REPLACE_ME
UCP_KMS_ENDPOINT=REPLACE_ME

# --- CORS (web frontend origin, if you run it against this engine) ---
SOCIETY_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
